# ---------------------------------------------------------------------------
# Backend Fastify — Variables serveur. JAMAIS exposées au navigateur.
# Copiez ce fichier vers server/.env
# ---------------------------------------------------------------------------

# Connexion PostgreSQL
DATABASE_URL="postgresql://ndjam:ndjam_dev_password@localhost:5432/ndjam_boisson?schema=public"

# Port d'écoute de l'API
PORT=3000
HOST=0.0.0.0

# Origines autorisées par le CORS (séparées par des virgules)
CORS_ORIGINS=http://localhost:8080

# Secret de signature des JWT. Générer avec :
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="remplacez-moi-par-un-secret-aleatoire-de-64-caracteres-minimum"

# Durée de vie des jetons
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30

# Taux de commission de la plateforme, en pourcentage
PLATFORM_COMMISSION_PERCENT=10

# ---------------------------------------------------------------------------
# Tests d'intégration
# ---------------------------------------------------------------------------
NODE_ENV=test