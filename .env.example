# ---------------------------------------------------------------------------
# Frontend (Vite) — lu par Vite, donc exposés au navigateur.
# Ne jamais y placer de secret.
# Les variables serveur (DATABASE_URL, JWT_SECRET...) vivent dans server/.env
# ---------------------------------------------------------------------------

# URL de l'API backend
VITE_API_BASE_URL=http://localhost:3000

# Identifiants du service de cartographie utilisé pour l'optimisation de tournée
VITE_MAPS_API_KEY=

# Passer à "true" pour afficher les données de démonstration plutôt que l'API
VITE_USE_MOCK_API=false