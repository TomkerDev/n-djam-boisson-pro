# URL de l'API backend (non utilisée tant que le MVP est en mode démo)
VITE_API_BASE_URL=http://localhost:3000

# Identifiants du service de cartographie utilisé pour l'optimisation de tournée
VITE_MAPS_API_KEY=

# Passer à "true" pour afficher les données de démonstration plutôt que l'API
VITE_USE_MOCK_API=true